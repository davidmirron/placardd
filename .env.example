# Copy to .env.local for local development. Everything is optional locally; the first three are required in production.

# --- Required in production -------------------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the deployment, used for Stripe redirect URLs. No trailing slash.
APP_URL=https://placard.app
# Demo accounts use a well-known password. Seeding is on by default in development and OFF in production
# unless this is explicitly "true".
SEED_DEMO_DATA=false

# --- Payments ---------------------------------------------------------------------------------------
# Without a key the built-in test checkout is used. With it, brands pay through Stripe Checkout and
# refunds go through Stripe too.
STRIPE_SECRET_KEY=
# Signing secret for /api/webhooks/stripe (checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
# Placard's share of each sale, as a percentage of the price. Creators see their net earnings in the
# listing builder; brands only ever see the price.
PLATFORM_FEE_PERCENT=15

# --- Database & files -------------------------------------------------------------------------------
# Local SQLite file, or a Turso/libsql URL (with DATABASE_AUTH_TOKEN).
DATABASE_URL=file:./data/placard.db
DATABASE_AUTH_TOKEN=
# Where uploads are written. Must be a persistent disk in production.
UPLOAD_DIR=./data/uploads

# --- Operations -------------------------------------------------------------------------------------
# Protects GET /api/cron/settle (Bearer token). Point a scheduler at it every few minutes to release
# expired holds, auto-approve unanswered proof and reveal sealed reviews on time.
CRON_SECRET=
# Where "Escalate to Placard" on a disputed order sends people.
NEXT_PUBLIC_SUPPORT_EMAIL=support@placard.app
# Auction engine is built but off. Leave unset.
# NEXT_PUBLIC_AUCTIONS_ENABLED=true
